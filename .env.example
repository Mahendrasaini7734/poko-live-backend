# ---- Host Daily LIVE Task (all optional; defaults shown = PRODUCTION) ----
DAILY_TASK_TARGET_MINUTES=60
DAILY_TASK_REWARD_COINS=1000
DAILY_TASK_UPDATE_INTERVAL_MINUTES=1
DAILY_TASK_ENABLED=true

# ---- 12 minute TEST MODE: put these in .env and restart Node, no Flutter change needed ----
# DAILY_TASK_TARGET_MINUTES=12
# DAILY_TASK_UPDATE_INTERVAL_MINUTES=3
# DAILY_TASK_REWARD_COINS=1000

# ---- Live session lifecycle ----
# A LIVE with no heartbeat (app) / no socket (older app) for this long is finalized by the server reaper
LIVE_STALE_SECONDS=120

# ---- Live start guard (seconds): a session with proof of life this recent blocks a 2nd start ----
LIVE_START_GUARD_SECONDS=45

# ---- Live realtime / recovery ----
# A host whose socket drops while LIVE has this long to come back before the live is ended for everybody
LIVE_DISCONNECT_GRACE_SECONDS=60
# Host socket still connected but heartbeat silent: keep the live for this long before treating it as dead
LIVE_STALE_WITH_SOCKET_SECONDS=900
# Agora token lifetime handed to viewers (liveSync returns a fresh one on every call)
LIVE_VIEWER_TOKEN_HOURS=24
# socket.io heartbeat (ms): a client is declared disconnected after interval + timeout
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=40000

# ---- Payments: Razorpay (server side only; NEVER ship these in the app) ----
# Preferred over the values stored in the admin Settings. Use rzp_test_* keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you type in Razorpay Dashboard > Webhooks (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
# How long (ms) gateway switches are cached between reads. 0 = always read the database.
PAYMENT_SETTINGS_CACHE_MS=3000

# ---- Payments: Google Play (already used) ----
# GOOGLE_PLAY_PACKAGE_NAME=
# GOOGLE_SERVICE_ACCOUNT_JSON=
